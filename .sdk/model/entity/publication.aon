# Entity: publication

main: kit: entity: publication: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      short: "Author of the publication"
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      short: "Category of the publication (e.g., investigation, news)"
      type: "`$STRING`"
    }
    {
      name: "content"
      req: false
      short: "Content body of the publication"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the publication"
      type: "`$STRING`"
    }
    {
      name: "media"
      req: false
      short: "Media content associated with the publication"
      type: "`$ARRAY`"
    }
    {
      format: "date-time"
      name: "published_at"
      req: false
      short: "Publication date and time"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the publication"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "URL to the full publication"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "publication"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 50
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/tg-news"
          segments: [
            {
              lit: "tg-news"
            }
          ]
          select: {
            exist: [
              "limit"
              "offset"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.publications`"
          }
        }
      ]
    }
  }



}
